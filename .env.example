# Public HTTPS origin where this service is deployed, no trailing path.
MCP_PUBLIC_BASE_URL=https://mcp.example.com
# OAuth/OIDC authorization server and JWKS used to verify inbound user tokens.
MCP_AUTH_ISSUER=https://auth.example.com/
MCP_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_AUTHORIZATION_SERVER=https://auth.example.com/
MCP_TENANT_CLAIM=tenant_id
MCP_SCOPE_CLAIM=scope
MCP_REQUIRED_SCOPES=tools:read
MCP_ADVERTISED_SCOPES=tools:read,tools:execute

# MGR Legacy authoritative business/action endpoint.
LEGACY_BASE_URL=https://legacy.example.com/
# Optional service credential for API-MCP -> Legacy. Never commit the real value.
LEGACY_SERVICE_TOKEN=
LEGACY_TIMEOUT_MS=15000

# Optional: MGR Forge Source Atlas reads + durable local world job tools. All three must be set
# together, and the verified inbound OAuth tenant must match the allowed tenant.
# Read uses tools:read; materializing a world requires tools:execute and the bound owner tenant.
# The Forge Studio is a loopback workstation; a hosted edge cannot reach it
# until an explicitly approved authenticated transport/relay exists.
# MGR_FORGE_STUDIO_URL=http://127.0.0.1:PORT_FROM_FORGE_STUDIO
# MGR_FORGE_STUDIO_TOKEN=secure-local-studio-token-from-active-session
# MGR_FORGE_TENANT_ID=owner-tenant-id

PORT=8787

# Optional Rare -> MGR API/MCP -> Code Monster connector, all three together.
# Code Monster's internal service must be reachable via private HTTPS, or a
# loopback URL on the SAME machine. Do not expose its HMAC listener publicly.
# The key is generated and stored privately on both services (32+ random bytes,
# base64); it is NOT an OpenAI/model key and must never enter Git or tool args.
# MGR_CODE_MONSTER_URL=https://internal-code-monster.example/
# MGR_CODE_MONSTER_BRIDGE_SECRET_BASE64=
# MGR_CODE_MONSTER_TENANT_ID=verified-oauth-owner-tenant
# This config enables read tools; repair.stage still requires a separately
# wired, persistent server-side exact-action approval resolver.
